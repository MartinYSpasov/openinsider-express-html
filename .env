# Postgres
DATABASE_URL=postgresql://app:app@db:5432/insiders

# Cron schedule (CRON format). Default: every 15 minutes
SCRAPE_CRON=*/15 * * * *

# Scraper tuneables
PAGES=3
MIN_VALUE_USD=500000
ROLES=CEO,CFO
CLUSTER_WINDOW_DAYS=7
CLUSTER_MIN_INSIDERS=2
CLUSTER_MIN_TOTAL_USD=500000
USER_AGENT=InsiderResearchBot/1.0

# Web
PORT=4000
